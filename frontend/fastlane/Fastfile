default_platform(:ios)

platform :ios do
  desc "构建并导出 IPA"
  lane :build_and_export do
    team_id = ENV["APPLE_TEAM_ID"]
    app_id = "com.fareast.fareastWorkerApp"

    # 同步（只读）Match 证书与 App Store 配置文件到本机钥匙串
    profiles = match(
      type: "appstore",
      readonly: true,
      app_identifier: [app_id],
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    profile_name = profiles[app_id]
    UI.user_error!("未找到 Match 安装的 App Store provisioning profile") unless profile_name

    # 取 profile UUID（无空格，xcargs 安全）—— match 内部调 sigh 后自动写入
    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    UI.user_error!("未获取到 provisioning profile UUID") unless profile_uuid

    gym(
      scheme: "Runner",
      workspace: "ios/Runner.xcworkspace",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      # 用 UUID 做 PROVISIONING_PROFILE_SPECIFIER（无空格，gym xcargs 不拆分）
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid}",
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        provisioningProfiles: {
          app_id => profile_name
        },
        uploadBitcode: false,
        uploadSymbols: true
      },
      output_directory: "build/ios/ipa",
      output_name: "fareast_worker_app.ipa"
    )
  end

  desc "上传 IPA 到 TestFlight"
  lane :upload_testflight do
    pilot(
      ipa: "build/ios/ipa/fareast_worker_app.ipa",
      skip_waiting_for_build_processing: true,
      notify_external_testers: false
    )
  end

  desc "初始化 Match 证书仓库（仅首次运行，非只读模式）"
  lane :init_match do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
    )
    match(type: "development", readonly: false, api_key: api_key)
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  desc "仅同步签名证书（调试用）"
  lane :sync_certs do
    match(type: "appstore", readonly: true)
  end
end
