# =============================================
# 远东工友 App — 环境变量模板
# =============================================
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
#
# ⚠️ .env 包含敏感信息，已加入 .gitignore
# =============================================

# ========== PostgreSQL ==========
POSTGRES_DB=fareast_worker
POSTGRES_USER=fareast
POSTGRES_PASSWORD=请修改为强密码_至少16位
POSTGRES_PORT=5432

# ========== Redis ==========
REDIS_PASSWORD=可选_设置Redis访问密码
REDIS_PORT=6379

# ========== 应用 ==========
APP_PORT=8080
DOMAIN=fsapp.fefacade.com

# ========== JWT（生成命令: openssl rand -base64 64）==========
JWT_SECRET=请修改为随机64位Base64字符串

# ========== 阿里云短信（可选，不影响核心打卡功能）==========
SMS_ACCESS_KEY_ID=your-aliyun-access-key
SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
SMS_TEMPLATE_CODE=SMS_335260681

# ========== 飞书集成（可选）==========
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
