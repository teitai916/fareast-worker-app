# Xcode 项目文件必须使用 LF 行尾
*.pbxproj text eol=lf
*.xcworkspacedata text eol=lf
*.xcscheme text eol=lf
*.xcconfig text eol=lf
*.plist text eol=lf
*.xcsettings text eol=lf

# 图片和二进制文件不转换行尾
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary

# shell 脚本始终用 LF
*.sh text eol=lf
